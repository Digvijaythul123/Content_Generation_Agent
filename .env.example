# Copy to .env and fill in. Never commit .env.

# Text model (defaults shown; both are optional)
MODEL_ENDPOINT=http://localhost:11434/api/generate
MODEL_NAME=gemma4:31b-cloud

# Background artwork for the quote_painting layout.
# ART_PROVIDER: cloudflare (free daily Workers AI allowance) or gemini (paid).
ART_PROVIDER=cloudflare
# Cloudflare API token with the "Workers AI" permission. The account ID
# defaults to R2_ACCOUNT_ID below.
CLOUDFLARE_AI_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Gemini (requires billing enabled on the Google AI Studio project).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Instagram API with Instagram Login (Creator/Business account)
# Long-lived token with instagram_business_basic + instagram_business_content_publish.
# Refresh before it expires (60 days): python3 -m scripts.publish_post --refresh-token
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com/v23.0

# Cloudflare R2: temporary public hosting that Instagram fetches the image from.
# Images are uploaded only when you publish, and deleted after a successful post.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL, e.g. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=

# Facebook Page (optional): Reels posted to Instagram also go to this Page.
# Use a Page access token with pages_show_list, pages_read_engagement, and
# pages_manage_posts (a Page token made from a long-lived user token does
# not expire). Check with: python3 -m scripts.publish_post --check
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
